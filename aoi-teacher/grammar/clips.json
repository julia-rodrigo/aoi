 {
  "file": "917295050ac3.mp3",
  "tts": "やまにもさとにものはらにもさくえ。"
 },
 {
  "file": "91895cdc75c7.mp3",
  "tts": "こなかった。"
 },
 {
  "file": "9214a8c4ad38.mp3",
  "tts": "そのてをうえにあげてください。"
 },
 {
  "file": "92f9a32f5553.mp3",
  "tts": "まめ、ほしいのん？ほら、あげるえ。"
 },
 {
  "file": "93b234b68497.mp3",
  "tts": "したであじがわかります。"
 },
 {
  "file": "93e44d86790b.mp3",
  "tts": "がくせいだった。"
 },
 {
  "file": "9437eb515716.mp3",
  "tts": "おかいけい。"
 },
 {
  "file": "94b3f0849d9e.mp3",
  "tts": "うまわはやくはしります。"
 },
 {
  "file": "94f9438271bb.mp3",
  "tts": "チョウわひらひら、ハチわブンブン、ホタルピカピカ、セミわミンミン！"
 },
 {
  "file": "95a88c47c541.mp3",
  "tts": "はながさくえ。どこにさくんやろか？"
 },
 {
  "file": "95aa874e549e.mp3",
  "tts": "チョウ。"
 },
 {
  "file": "968461845182.mp3",
  "tts": "こぶなつりしかのかわ。"
 },
 {
  "file": "96efba2f3e43.mp3",
  "tts": "ほんまにあかん！"
 },
 {
  "file": "97579ceb6826.mp3",
  "tts": "しずかなやまで、セミのこえがいわにしみこむみたいどす。"
 },
 {
  "file": "975d198bb31b.mp3",
  "tts": "きのうはさむかったです。"
 },
 {
  "file": "9773e3aae1c9.mp3",
  "tts": "はるがきたえ。どこにきたんやろか？"
 },
 {
  "file": "98461aadc51a.mp3",
  "tts": "なのはなばたけで、ひがしにつきがでて、にしにひがしずむ。"
 },
 {
  "file": "9880d7b768dc.mp3",
  "tts": "ごちそうさまでした。"
 },
 {
  "file": "990ad2f7366b.mp3",
  "tts": "あるひ、あかずきんわもりのおばあちゃんのいえにいってん。"
 },
 {
  "file": "99b40c4af8e2.mp3",
  "tts": "トンボわむしをたべます。"
 },
 {
  "file": "99d8fdc6251e.mp3",
  "tts": "ながれぼしにねがいをいいます。"
 },
 {
  "file": "99ebfc8c6cf6.mp3",
  "tts": "はい、いきます。"
 },
 {
  "file": "9a8122018385.mp3",
  "tts": "スズメ。"
 },
 {
  "file": "9ab6275fc010.mp3",
  "tts": "もくせいわいちばんおおきいわくせいです。"
 },
 {
  "file": "9adcbf488774.mp3",
  "tts": "きょうとわしずかなまちです。"
 },
 {
  "file": "9b11a7c729a2.mp3",
  "tts": "かぐやひめわつきえかえっていきました。"
 },
 {
  "file": "9c1e0a1ecdfa.mp3",
  "tts": "ボウルにこむぎこ、さとう、ベーキングパウダー、しおをいれてまぜてね。"
 },
 {
  "file": "9c803338f58a.mp3",
  "tts": "まめがほしおすか？どうぞ、おあがりやす。"
 },
 {
  "file": "9cd867a12475.mp3",
  "tts": "ハチ。"
 },
 {
  "file": "9cf4aca84259.mp3",
  "tts": "ながれぼし。"
 },
 {
  "file": "9d13bee7181b.mp3",
  "tts": "ぞう。"
 },
 {
  "file": "9d4013563653.mp3",
  "tts": "ももたろうわおにがしまえおにたいじにいった。"
 },
 {
  "file": "9d5f3afd290f.mp3",
  "tts": "まほうをかけます。"
 },
 {
  "file": "9d62a37395ff.mp3",
  "tts": "これわおちゃです。"
 },
 {
  "file": "9dccb0ebdcc9.mp3",
  "tts": "いついきますか？"
 },
 {
  "file": "9e24578a0179.mp3",
  "tts": "でらうまい！"
 },
 {
  "file": "9e4e66a63dde.mp3",
  "tts": "なんでそないにおそおすの？"
 },
 {
  "file": "9e692b48c7f1.mp3",
  "tts": "かごのなかのとりは。"
 },
 {
  "file": "9eb630a11a53.mp3",
  "tts": "かぐやひめわつきをみて、ないてた。"
 },
 {
  "file": "9ed46879a661.mp3",
  "tts": "ゆでじるをカップいっぱいとっておいて、おゆをきってね。"
 },
 {
  "file": "9f530cad8504.mp3",
  "tts": "はなでにおいをかぎます。"
 },
 {
  "file": "a061b6e0aa5c.mp3",
  "tts": "じゅもん。"
 },
 {
  "file": "a0be161962d4.mp3",
  "tts": "においぞいずる。"
 },
 {
  "file": "a0d24d08a24c.mp3",
  "tts": "ハチわはちみつをつくります。"
 },
 {
  "file": "a0e1872a202e.mp3",
  "tts": "ねえ、カメさん。"
 },
 {
  "file": "a13e22d5e92d.mp3",
  "tts": "ももからげんきなおとこのこがうまれた。"
 },
 {
  "file": "a13f9aaf940f.mp3",
  "tts": "かいて。"
 },
 {
  "file": "a16ce2b47171.mp3",
  "tts": "ひだり。"
 },
 {
  "file": "a17feccc82b9.mp3",
  "tts": "はながさくはながさくどこにさく。"
 },
 {
  "file": "a1b31673ebf1.mp3",
  "tts": "あんたをたべるためですわ！"
 },
 {
  "file": "a29aadaa6f5a.mp3",
  "tts": "うしろにいるのわだれ？"
 },
 {
  "file": "a3d311120bab.mp3",
  "tts": "あのかわでこぶなつったなあ。"
 },
 {
  "file": "a3ee831e834e.mp3",
  "tts": "わすれられへんふるさとどす。"
 },
 {
  "file": "a40f4ae14fa1.mp3",
  "tts": "おみず。"
 },
 {
  "file": "a462231d0d29.mp3",
  "tts": "きてください。"
 },
 {
  "file": "a54d13f00f82.mp3",
  "tts": "フライパンにあぶらをいれて、つよびでよくねっします。"
 },
 {
  "file": "a55129add032.mp3",
  "tts": "まいあさはをみがきます。"
 },
 {
  "file": "a672232037d5.mp3",
  "tts": "パスタをフライパンにいれて、ゆでじるをすこしくわえ、ちゅうびでいっぷんほどまぜます。"
 },
 {
  "file": "a6ed64922261.mp3",
  "tts": "せんせいがきはった。"
 },
 {
  "file": "a7525e924149.mp3",
  "tts": "カラスわカーカー、スズメわチュンチュン、ハトわポッポー、ニワトリコケコッコー！"
 },
 {
  "file": "a7a1aa23d8ef.mp3",
  "tts": "かえる。"
