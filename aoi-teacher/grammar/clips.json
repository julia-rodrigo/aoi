 },
 {
  "file": "a835494ed221.mp3",
  "tts": "ハトがぽっぽってないてはる。"
 },
 {
  "file": "a8a9f2a18caa.mp3",
  "tts": "きびだんごをあげて、いぬとさるとキジがなかまになりました。"
 },
 {
  "file": "a9657fac467d.mp3",
  "tts": "おみずをください。"
 },
 {
  "file": "a9ce0be41f4e.mp3",
  "tts": "はわひかりでえいようをつくります。"
 },
 {
  "file": "aa4c18c9c918.mp3",
  "tts": "みわたすかぎり、くもみたいにさくらがさいておす。"
 },
 {
  "file": "ab473429d1d7.mp3",
  "tts": "いまでもゆめにみるよ。"
 },
 {
  "file": "ab7078535eab.mp3",
  "tts": "みわたすかぎり。"
 },
 {
  "file": "abcb974177f3.mp3",
  "tts": "きょうはいかへん。"
 },
 {
  "file": "ac6649a827eb.mp3",
  "tts": "かど。"
 },
 {
  "file": "ac75262c14eb.mp3",
  "tts": "おまえのこえがようきこえるようにや。"
 },
 {
  "file": "af5bd53c27fe.mp3",
  "tts": "ほくとしちせい。"
 },
 {
  "file": "af9ad3b545d5.mp3",
