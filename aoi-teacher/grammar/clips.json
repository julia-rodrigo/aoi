 },
 {
  "file": "8d4d7e269783.mp3",
  "tts": "くろねこわまじょのともだちです。"
 },
 {
  "file": "8e1324e23d2e.mp3",
  "tts": "オーブンをにひゃくにじゅうどによねつします。"
 },
 {
  "file": "8e19eec08529.mp3",
  "tts": "そのてをうえにあげて！"
 },
 {
  "file": "8e443d0aacc6.mp3",
  "tts": "かぐやひめわ、えらいきれいにならはりました。"
 },
 {
  "file": "8e7ef915dc57.mp3",
  "tts": "たくさんのひとが、けっこんしたいっていった。"
 },
 {
  "file": "8fa361d90174.mp3",
  "tts": "なつまつりでゆかたをきます。"
 },
 {
  "file": "8fc9d85f2880.mp3",
  "tts": "せやけど、かぐやひめわむずかしいたからものをたのんで、ことわらはりました。"
 },
 {
  "file": "8fdc413abda8.mp3",
  "tts": "ねこわニャーとなきます。"
 },
 {
  "file": "908ee4ad308e.mp3",
  "tts": "ももたろうわおにがしまえおにたいじにいきました。"
 },
 {
  "file": "90c3f9d8c9d1.mp3",
  "tts": "こがあるからよ。"
