  "tts": "せかいでおまえほどおそいやつおらへんで。"
 },
 {
  "file": "6e19035ad25e.mp3",
  "tts": "あし。"
 },
 {
  "file": "6f4f36afdbdf.mp3",
  "tts": "かいおうせい。"
 },
 {
  "file": "6fa1b7f497bd.mp3",
  "tts": "ここからちかいですか？"
 },
 {
  "file": "703b6000b6dc.mp3",
  "tts": "やせガエル、まけるな！いっさがここにいるぞ！"
 },
 {
  "file": "705c96154c6d.mp3",
  "tts": "めでみる、みみできく、はなでかいで、くちでたべる！"
 },
 {
  "file": "712406d96faf.mp3",
  "tts": "わくせい。"
 },
 {
  "file": "71366d2a6650.mp3",
  "tts": "ワンピースをきます。"
 },
 {
  "file": "716ea8f13316.mp3",
  "tts": "ソースをそそいでふたをして、よわびでじゅうごふんからにじゅっぷんにこんだらかんせい！"
 },
 {
  "file": "71c8fbe385ad.mp3",
  "tts": "します。"
 },
 {
  "file": "71d4aedec409.mp3",
  "tts": "もりで、オオカミにおうてん。"
 },
 {
  "file": "7234984f69c0.mp3",
  "tts": "さくらわはるにさきます。"
 },
 {
  "file": "726c0a737e29.mp3",
  "tts": "たかかったです。"
 },
 {
  "file": "7281d5a1ea56.mp3",
  "tts": "セミ。"
 },
 {
  "file": "72ab916b0b79.mp3",
  "tts": "つえをふって、じゅもんをとなえます。"
 },
 {
  "file": "72fa7465dba6.mp3",
  "tts": "あのひとわだれですか？"
 },
 {
  "file": "73600754cbea.mp3",
  "tts": "おび。"
 },
 {
  "file": "739486b5dfe3.mp3",
  "tts": "やせがえるまけるないっさこれにあり。"
 },
 {
  "file": "739e0b105c30.mp3",
  "tts": "ぽっぽっぽはとぽっぽ。"
 },
 {
  "file": "74be41e417a4.mp3",
  "tts": "したい。"
 },
 {
  "file": "74bf91f9c8b2.mp3",
  "tts": "すいとーよ。"
 },
 {
  "file": "7532da957996.mp3",
  "tts": "ごっついももが、どんぶらこってながれてきてん。"
 },
 {
  "file": "754b998c7f25.mp3",
  "tts": "かぐやひめわつきえかえっていかはりました。"
 },
 {
  "file": "7554cd2c1468.mp3",
  "tts": "うしろにおるんわだれや？"
 },
 {
  "file": "7562f4c2b30e.mp3",
  "tts": "なんでそないにおそいん？"
 },
 {
  "file": "76bb0ebb9ed4.mp3",
  "tts": "あるいてごふんぐらいです。"
 },
 {
  "file": "76ec0d1ffcfa.mp3",
  "tts": "むかしむかし、おばあさんがかわでせんたくをしていました。"
 },
 {
  "file": "77137bb6a037.mp3",
  "tts": "おんぶされてみたのわいつだったでしょう。"
 },
 {
  "file": "7799fa3fe11a.mp3",
  "tts": "きつねわコンコンとなきます。"
 },
 {
  "file": "7812bbec9ed4.mp3",
  "tts": "あのやまでうさぎをおいかけたね。"
 },
 {
  "file": "782407fe29b2.mp3",
  "tts": "ほし。"
 },
 {
  "file": "786b8e540ed7.mp3",
  "tts": "アリ。"
 },
 {
  "file": "787176985e55.mp3",
  "tts": "わすれられへんふるさとです。"
 },
 {
  "file": "789920791836.mp3",
  "tts": "わたしわつきのみやこのものなの。"
 },
 {
  "file": "78a07c0b7b6d.mp3",
  "tts": "スカートをはきます。"
 },
 {
  "file": "7a026e336f4c.mp3",
  "tts": "きびだんごをあげて、いぬとさるとキジがなかまになった。"
 },
 {
  "file": "7b12915b3af7.mp3",
  "tts": "あのやまでうさぎをおいかけました。"
 },
 {
  "file": "7b55e724a670.mp3",
  "tts": "たれをまわしいれていっぷんほどいため、ごはんにのせます。"
 },
 {
  "file": "7b81ca256d4f.mp3",
  "tts": "きつね。"
 },
 {
  "file": "7c0871b7c62d.mp3",
  "tts": "いぬ。"
 },
 {
  "file": "7c9c18ca5a0c.mp3",
  "tts": "やまにかわいいこどもがいるからですよ。"
 },
 {
  "file": "7ce59e811c64.mp3",
  "tts": "いって。"
 },
 {
  "file": "7d55902d5e5d.mp3",
  "tts": "かぐやひめわとてもうつくしくなった。"
 },
 {
  "file": "7d921b019755.mp3",
  "tts": "ぎょうさんのひとが、けっこんしたいていわはりました。"
 },
 {
  "file": "7d944ac378fd.mp3",
  "tts": "のこりのあぶらをたして、さいのめのやさいをいち、にふんいためます。"
 },
 {
  "file": "7dd2120a5206.mp3",
  "tts": "やまにもさとにものはらにもきたえ。"
 },
 {
  "file": "7de1e5975edd.mp3",
  "tts": "ほうき。"
 },
 {
  "file": "7de221e99328.mp3",
  "tts": "たまごをもどしておおきくまぜ、しおであじをととのえます。"
 },
 {
  "file": "7e588f2dfb02.mp3",
  "tts": "やまにかわいいこどもがいるからだよ。"
 },
 {
  "file": "7e727bf4b726.mp3",
  "tts": "いたい。"
 },
 {
  "file": "7f98ce1bafd1.mp3",
  "tts": "チョウわはなのみつをすいます。"
 },
 {
  "file": "7fc702d6a80a.mp3",
  "tts": "がくせいじゃなかったです。"
 },
 {
  "file": "802dc68fc86c.mp3",
  "tts": "くさ。"
 },
 {
  "file": "81d7f3120014.mp3",
  "tts": "いってる。"
 },
 {
  "file": "81e05175013a.mp3",
  "tts": "ふたつめのかどをみぎにまがってください。"
 },
 {
  "file": "82aeb0a33666.mp3",
  "tts": "あるひ、ひかるたけのなかに、ちっちゃいおんなのこがおってん。"
 },
 {
  "file": "82f1e19de459.mp3",
  "tts": "えらいおおきいももが、どんぶらこってながれてきてん。"
 },
 {
  "file": "830d9f4a001d.mp3",
  "tts": "えきわどこですか？"
 },
 {
  "file": "83531e1afbb9.mp3",
  "tts": "ゆうやけのそらにあかとんぼがとんでる。"
 },
 {
  "file": "83ef311f4c81.mp3",
  "tts": "ツル。"
 },
 {
  "file": "844f817bc979.mp3",
  "tts": "やよいのそらは。"
 },
 {
  "file": "84c54b0767e2.mp3",
  "tts": "ちちんぷいぷい、いたいのいたいの、とんでいけ！"
 },
 {
  "file": "84e9d82a1598.mp3",
  "tts": "て。"
 },
 {
  "file": "850e6bd10150.mp3",
  "tts": "ひをとめて、パルメザンチーズとパセリをまぜ、しおとこしょうであじをととのえます。"
 },
 {
  "file": "8552ef1dea99.mp3",
  "tts": "しんごうをわたって、ひだりです。"
 },
 {
  "file": "85cb94980074.mp3",
  "tts": "あしたきょうとにいきます。"
 },
 {
  "file": "8601073f6817.mp3",
  "tts": "およいで。"
 },
 {
  "file": "8647c4b3f5fe.mp3",
  "tts": "かきをたべてたら、ほうりゅうじのかねがなった。"
 },
 {
  "file": "86b0a3af1b5e.mp3",
  "tts": "これをみてください。"
 },
 {
  "file": "86b3b91fd0aa.mp3",
  "tts": "ねつ。"
 },
 {
  "file": "86f5dafffd67.mp3",
  "tts": "そのてうえにあげてな。"
 },
 {
  "file": "870a03afebcd.mp3",
  "tts": "くち。"
 },
 {
  "file": "88f413d884d5.mp3",
  "tts": "びょうき。"
 },
 {
  "file": "8904ac684615.mp3",
  "tts": "ぼうしをかぶります。"
 },
 {
  "file": "893775b94ef6.mp3",
  "tts": "ほっきょくせい。"
 },
 {
  "file": "8956f5587c10.mp3",
  "tts": "いこう！"
 },
 {
  "file": "8a017d36d75d.mp3",
  "tts": "せき。"
 },
 {
  "file": "8a0f632f80d5.mp3",
  "tts": "からだ。"
 },
 {
  "file": "8a3ae46740df.mp3",
  "tts": "のう。"
 },
 {
  "file": "8afb8d9b0b89.mp3",
  "tts": "フクロウわよるおきています。"
 },
 {
  "file": "8affc0bcda1e.mp3",
  "tts": "カラスわカーカーとなきます。"
 },
 {
  "file": "8b20d0acdf32.mp3",
  "tts": "もくせい。"
 },
 {
  "file": "8b262ae71d22.mp3",
  "tts": "ふるいいけにカエルがとびこんで、みずのおとがしました。"
 },
 {
  "file": "8b26aa6dc0cb.mp3",
  "tts": "あるひ、あかずきんわもりのおばあちゃんのいえにいかはってん。"
 },
 {
  "file": "8b9236cd4b86.mp3",
  "tts": "はい。"
 },
 {
  "file": "8c1cb91f21bf.mp3",
  "tts": "みわたすかぎり、くもみたいにさくらがさいてる。"
 },
 {
  "file": "8c57ff769e1e.mp3",
  "tts": "とおい。"
 },
 {
  "file": "8cb088fb0eaf.mp3",
  "tts": "かぐやひめわつきにかえっていってん。"
 },
 {
  "file": "8cd581b78342.mp3",
  "tts": "いきませんでした。"
 },
 {
  "file": "8d26516aa713.mp3",
