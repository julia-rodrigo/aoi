[
 {
  "file": "0056a07c5328.mp3",
  "tts": "はるがきました。どこにきたのでしょう？"
 },
 {
  "file": "00caeac90cd5.mp3",
  "tts": "おおきなボウルでパンことぎゅうにゅうをまぜて、ごふんおきます。"
 },
 {
  "file": "00d9ca256f4a.mp3",
  "tts": "しました。"
 },
 {
  "file": "00e66802772c.mp3",
  "tts": "たかくない。"
 },
 {
  "file": "01290707211c.mp3",
  "tts": "たべた。"
 },
 {
  "file": "018d5f86752b.mp3",
  "tts": "くまわふゆにねむります。"
 },
 {
  "file": "028448636bc0.mp3",
  "tts": "いまごはんをたべています。"
 },
 {
  "file": "030b6da4f5b3.mp3",
  "tts": "せかいのうちでおまえほど。"
 },
 {
  "file": "03d43b85cc3a.mp3",
  "tts": "のこりのあぶらでトマトとさとうをさん、よんぷんいためて、やわらかくしてね。"
 },
 {
  "file": "03ef2e8ac96c.mp3",
  "tts": "たべています。"
 },
 {
  "file": "03f0252f4197.mp3",
  "tts": "みわたすかぎり、くもみたいにさくらがさいています。"
 },
 {
  "file": "04e7e8ae1a25.mp3",
  "tts": "そやけど、かぐやひめわむずかしいたからものをたのんで、ことわらはってん。"
 },
 {
  "file": "04f43b0ffe26.mp3",
  "tts": "なまえわももたろうどす。"
 },
 {
  "file": "052d1430cfc9.mp3",
  "tts": "ねわみずをすいます。"
 },
 {
  "file": "053901790b82.mp3",
  "tts": "ちゅうもん。"
 },
 {
  "file": "053db22f9d9f.mp3",
  "tts": "みんなでなかよくたべにこい。"
 },
 {
  "file": "055fa88c1214.mp3",
  "tts": "ぎょうさんのひとが、けっこんしたいていわはってん。"
 },
 {
  "file": "056276258391.mp3",
  "tts": "にんにくとしょうがをいれて、こげやすいからさんじゅうびょうまぜつづけてね。"
 },
 {
  "file": "05a3f5205253.mp3",
  "tts": "おさけわのみません。"
 },
 {
  "file": "05c797e88b1b.mp3",
  "tts": "ふるいいけにカエルがとびこんで、みずのおとがした。"
 },
 {
  "file": "05ef358ad955.mp3",
  "tts": "かぜ。"
 },
 {
  "file": "066810232e36.mp3",
  "tts": "たなばたわしちがつなのかです。"
 },
 {
  "file": "06b5553884ff.mp3",
  "tts": "たかくなかった。"
 },
 {
  "file": "0731f54ad880.mp3",
  "tts": "ほな、みにいこか！"
 },
 {
  "file": "07c2a2f41c81.mp3",
  "tts": "しんごう。"
 },
 {
  "file": "085d7c75b721.mp3",
  "tts": "オオカミわさきにおばあちゃんのいえにいきよってん。"
 },
 {
  "file": "0863b1c358b3.mp3",
  "tts": "しましょう。"
 },
 {
  "file": "08e9fdc601dc.mp3",
  "tts": "べつのボウルでぎゅうにゅうとたまごととかしバターをまぜます。"
 },
 {
  "file": "08fdcac729cc.mp3",
  "tts": "アリわみんなではたらきます。"
 },
 {
  "file": "0979630d69c8.mp3",
  "tts": "ハトがぽっぽってないてる。"
 },
 {
  "file": "099122c97e5e.mp3",
  "tts": "はるがきたよ。どこにきたのかな？"
 },
 {
  "file": "09a8b06b7e88.mp3",
  "tts": "ふるいいけにカエルがとびこんで、みずのおとがしてん。"
 },
 {
  "file": "09bdf1e9cbd4.mp3",
  "tts": "なあ、カメさん。"
 },
 {
  "file": "09bf1465cf3f.mp3",
  "tts": "いくべ！"
 },
 {
  "file": "09c57cd24ad8.mp3",
  "tts": "みんなわそのこをあかずきんてよんではりました。"
 },
 {
  "file": "09c5be07d384.mp3",
  "tts": "でんしゃでいきます。"
 },
 {
  "file": "09d2f6011cf5.mp3",
  "tts": "しょうゆとすとさとうをちいさなボウルでまぜて、たれをつくります。"
 },
 {
  "file": "09ed0c35ee5a.mp3",
  "tts": "は。"
 },
 {
  "file": "0a62baf7329e.mp3",
  "tts": "むかしむかし、たけをきるおじいさんがいました。"
 },
 {
  "file": "0a9a14c56631.mp3",
  "tts": "うさぎおいしかのやま。"
 },
 {
  "file": "0b4488fba80e.mp3",
  "tts": "おなかがいたいです。"
 },
 {
  "file": "0bb97d4e1e23.mp3",
  "tts": "おまえをくうためや！"
 },
 {
  "file": "0c02ff26f997.mp3",
  "tts": "しています。"
 },
 {
  "file": "0c122a103c8f.mp3",
  "tts": "むかしむかし、たけをきるおじいさんがいやはってん。"
 },
 {
  "file": "0c1a4464d1f8.mp3",
  "tts": "うしろにいはるのわどなたどす？"
 },
 {
  "file": "0c62d1fa297a.mp3",
  "tts": "もしもしかめよかめさんよ。"
 },
 {
  "file": "0c6dd03bd846.mp3",
  "tts": "いこう。"
 },
 {
  "file": "0cab210e0bb2.mp3",
  "tts": "かわいいななつの。"
 },
 {
  "file": "0cf1a53b8d5c.mp3",
  "tts": "きんせい。"
 },
 {
  "file": "0de54688dc5d.mp3",
  "tts": "しちじにおきます。"
 },
 {
  "file": "0e0dae1f3838.mp3",
  "tts": "くすり。"
 },
 {
  "file": "0ed8a81744cc.mp3",
  "tts": "せかいであんたほどおそいひといいひんえ。"
 },
 {
  "file": "0f3ff6169389.mp3",
  "tts": "ほね。"
 },
 {
  "file": "106cb9215e4e.mp3",
  "tts": "みんなわそのこをあかずきんとよびました。"
 },
 {
  "file": "109850c81702.mp3",
  "tts": "なんでそないにくちがおおきいんですか？"
 },
 {
  "file": "10c3eb619cd5.mp3",
  "tts": "ねつがあります。"
 },
 {
  "file": "1177edbd0011.mp3",
  "tts": "なんでそないにくちおおきいのん？"
 },
 {
  "file": "11828d4db8ed.mp3",
  "tts": "でも、かぐやひめわむずかしいたからものをたのんで、ことわった。"
 },
 {
  "file": "11a0153b023c.mp3",
  "tts": "さる。"
 },
 {
  "file": "11ff78331d00.mp3",
  "tts": "いきたいです。"
 },
 {
  "file": "121c6d3e1abf.mp3",
  "tts": "あんたをたべるためや！"
 },
 {
  "file": "127db0a8c4ea.mp3",
  "tts": "か。"
 },
 {
  "file": "132506582d32.mp3",
  "tts": "しずかです。"
 },
 {
  "file": "142c6c551856.mp3",
  "tts": "わたしわつきのみやこのものです。"
 },
 {
  "file": "144e9895706c.mp3",
  "tts": "たべなかった。"
 },
 {
  "file": "145f52f12168.mp3",
  "tts": "にんじんなどのかたいやさいをさきににふんいためてから、やわらかいやさいをいれてね。"
 },
 {
  "file": "14c611452fec.mp3",
  "tts": "なんでそないにおそいのん？"
 },
 {
  "file": "14e90e3dcc99.mp3",
  "tts": "うしろにいはるのわだれやろ？"
 },
 {
  "file": "15076f997a2b.mp3",
  "tts": "ゆめわいまもめぐりて。"
 },
 {
  "file": "152112d6ee15.mp3",
  "tts": "あたまがいたいです。"
 },
 {
  "file": "154a0648b1a1.mp3",
  "tts": "あかいずきんをかぶったおんなのこがおってん。"
 },
 {
  "file": "16e7530f46c7.mp3",
  "tts": "やまにきたさとにきたのにもきた。"
 },
 {
  "file": "1868ade4ea32.mp3",
  "tts": "あめじゃけえ、いかん。"
 },
 {
  "file": "199cf535ba40.mp3",
  "tts": "せやけど、りょうしさんがきて、ふたりをたすけはりました。"
 },
 {
  "file": "19e92ddf7151.mp3",
  "tts": "いきますか？"
 },
 {
  "file": "1acb588d0a8d.mp3",
  "tts": "きゅうきゅうしゃ。"
 },
 {
  "file": "1ae093eb54b4.mp3",
  "tts": "かごのなかのとりわ、いつでてくるのでしょう？"
 },
 {
  "file": "1b5959e8515d.mp3",
  "tts": "たかかった。"
 },
 {
  "file": "1b67b8d32a02.mp3",
  "tts": "のうでかんがえ、しんぞうドキドキ、はいでスーハー、ほねでささえる！"
 },
 {
  "file": "1b9e3a2acffd.mp3",
  "tts": "むし。"
 },
 {
  "file": "1bb4275116e2.mp3",
  "tts": "からすなぜなくの。"
 },
 {
  "file": "1bbd65ba9cb4.mp3",
  "tts": "とりわそらをとびます。"
 },
 {
  "file": "1be7ad98afc0.mp3",
  "tts": "ハト。"
 },
 {
  "file": "1c4bf1644613.mp3",
  "tts": "なのはなばたけで、ひがしにつきがでて、にしにひがしずみます。"
 },
 {
  "file": "1c82077a1c52.mp3",
  "tts": "かわちをすいます。"
 },
 {
  "file": "1cef8330b4b2.mp3",
  "tts": "たくさんのひとがけっこんしたいといいました。"
 },
 {
  "file": "1d13e5843215.mp3",
  "tts": "きません。"
 },
 {
  "file": "1efe055515dc.mp3",
  "tts": "びょういんにいきたいです。"
 },
 {
  "file": "1f781e750b68.mp3",
  "tts": "かぐやひめわとてもうつくしくなりました。"
 },
 {
  "file": "1f8234f6aaff.mp3",
  "tts": "あぶらをおおさじいっぱいねっしてたまごをいれ、ふんわりはんじゅくにいためてとりだします。"
 },
 {
  "file": "1f8705dfda31.mp3",
  "tts": "はなわいいにおいがします。"
 },
 {
  "file": "1fb2566a1583.mp3",
  "tts": "スズメのこ、よけてください。おうまさんがとおりますよ。"
 },
 {
  "file": "2052bd3c238f.mp3",
  "tts": "いかなかった。"
 },
 {
  "file": "210b2ebb6b03.mp3",
  "tts": "かきくえばかねがなるなりほうりゅうじ。"
 },
 {
  "file": "213b939cdf5e.mp3",
  "tts": "まめがほしいですか？どうぞ、あげますよ。"
 },
 {
  "file": "218f113c63a4.mp3",
  "tts": "たねからめがでます。"
 },
 {
  "file": "21a786f3503a.mp3",
  "tts": "このらーめんわおいしいです。"
 },
 {
  "file": "21c159c8f919.mp3",
  "tts": "たべませんでした。"
 },
 {
  "file": "21c50078875a.mp3",
  "tts": "ほな、みにいきまひょか。"
 },
 {
  "file": "21ca538b9ac0.mp3",
  "tts": "かぐやひめ、えらいきれいにならはってん。"
 },
 {
  "file": "21f8e761675f.mp3",
  "tts": "くつ。"
 },
 {
  "file": "220f8cb0c109.mp3",
  "tts": "むかしむかし、おばあさんがかわでせんたくをしてた。"
 },
 {
  "file": "232491de7020.mp3",
  "tts": "ようびのなまえわほしからきています。"
 },
 {
  "file": "232962aeb743.mp3",
  "tts": "いった。"
 },
 {
  "file": "23703df235cd.mp3",
  "tts": "ももたろうわたからものもって、いえにかえってん。"
 },
 {
  "file": "23a2111dc013.mp3",
  "tts": "かえって。"
 },
 {
  "file": "23dbbb89261d.mp3",
  "tts": "さるわきにのぼります。"
 },
 {
  "file": "245187181ed1.mp3",
  "tts": "たね。"
 },
 {
  "file": "24fedf6b6b32.mp3",
  "tts": "そのあいだに、フライパンでバターをよわびでとかして、にんにくととうがらしをこがさないようにいためてね。"
 },
 {
  "file": "250bd3df475c.mp3",
  "tts": "わたしもいきます。"
 },
 {
  "file": "2582f0e46f86.mp3",
  "tts": "ふく。"
 },
 {
  "file": "25b0fd65e93e.mp3",
  "tts": "うし。"
 },
 {
  "file": "264f9635eb76.mp3",
  "tts": "おおきななべでおゆをわかしてしおをいれ、スパゲッティをすこしかためにゆでます。"
 },
 {
  "file": "26525e1768f9.mp3",
  "tts": "こない。"
 },
 {
  "file": "2693856436b4.mp3",
  "tts": "こなにえきをいれてさっくりまぜてね。まぜすぎるとかたくなるよ。"
 },
 {
  "file": "26e9454965c6.mp3",
  "tts": "しなかった。"
 },
 {
  "file": "271b665e113c.mp3",
  "tts": "たけわとてもはやくのびます。"
 },
 {
  "file": "27b464ab7533.mp3",
  "tts": "のうでかんがえます。"
 },
 {
  "file": "2803e8fb7b6d.mp3",
  "tts": "おばあちゃん、なんでそないにみみでかいん？"
 },
 {
  "file": "286c9e35ed71.mp3",
  "tts": "まんげつのよる、つきからむかえがきはりました。"
 },
 {
  "file": "288e8f31c05e.mp3",
  "tts": "アイスとクリーム、いちごとウエハースをかざって、すぐにたべてね！"
 },
 {
  "file": "294b83ab530b.mp3",
  "tts": "しずかだ。"
 },
 {
  "file": "2997e21f9ff6.mp3",
  "tts": "すみません、カメさん。"
 },
 {
  "file": "2a1281d44c3c.mp3",
  "tts": "いちごをあらってみずけをふいて、にこわかざりようにのこして、のこりをきってね。"
 },
 {
  "file": "2a6318c41d40.mp3",
  "tts": "せかいであなたほどおそいひとわいませんよ。"
 },
 {
  "file": "2a9d4e205d9b.mp3",
  "tts": "でも、かぐやひめわむずかしいたからものをたのんで、ことわりました。"
 },
 {
  "file": "2ab9ee746b3b.mp3",
  "tts": "しない。"
 },
 {
  "file": "2c173bda4365.mp3",
  "tts": "せのたかいグラスのそこにジャムをいれて、きったいちごをいれてね。"
 },
 {
  "file": "2c210be044ea.mp3",
  "tts": "カラスわなぜないているのですか？"
 },
 {
  "file": "2c763ca98ee7.mp3",
  "tts": "いまでもゆめにみます。"
 },
 {
  "file": "2c9388f5ed63.mp3",
  "tts": "やまにもさとにものはらにもきたよ。"
 },
 {
  "file": "2cfa74bdee05.mp3",
  "tts": "つめたいなまクリームにさとうをくわえて、ゆるくつのがたつまであわだてます。"
 },
 {
  "file": "2d170e6bcbd1.mp3",
  "tts": "まめ、ほしい？ほら、あげるよ。"
 },
 {
  "file": "2e212091023d.mp3",
  "tts": "あるひ、ひかるたけのなかに、ちっちゃいおんなのこがいてん。"
 },
 {
  "file": "2e6616f4ca7c.mp3",
  "tts": "わすれられへんふるさとや。"
 },
 {
  "file": "2e8b964a0a5e.mp3",
  "tts": "のこりのあぶらでトマトとさとうをさん、よんぷんいためて、やわらかくします。"
 },
 {
  "file": "2eb3029b4c6f.mp3",
  "tts": "ちょっけいよんセンチくらいにまるめます。てをぬらすとくっつきません。"
 },
 {
  "file": "2ef6d06e3567.mp3",
  "tts": "すいせい。"
 },
 {
  "file": "2f0081e3c290.mp3",
  "tts": "すみません、ちゅうもんおねがいします。"
 },
 {
  "file": "2f19359b53c1.mp3",
  "tts": "ゆうやけのそらにあかとんぼがとんではる。"
 },
 {
  "file": "2f554d65ea56.mp3",
  "tts": "うしわモーとなきます。"
 },
 {
  "file": "2f9785671486.mp3",
  "tts": "やまにかわいいこどもがいるからどす。"
 },
 {
  "file": "3028236163fc.mp3",
  "tts": "しませんでした。"
 },
 {
  "file": "302c9d3b0d06.mp3",
  "tts": "つるとかめがすべった。"
 },
 {
  "file": "3059a232ebc1.mp3",
  "tts": "こよう。"
 },
 {
  "file": "30a2ab7692a4.mp3",
  "tts": "おなか。"
 },
 {
  "file": "30f5083961ee.mp3",
  "tts": "かぐやひめわつきをみて、ないてはりました。"
 },
 {
  "file": "3185ffc89a50.mp3",
  "tts": "のむ。"
 },
 {
  "file": "31f60088d695.mp3",
  "tts": "みわたすかぎり、くもみたいにさくらがさいとる。"
 },
 {
  "file": "323e91503ddc.mp3",
  "tts": "はながさくよ。どこにさくのかな？"
 },
 {
  "file": "32d11bb9184f.mp3",
  "tts": "ねこがすきです。"
 },
 {
  "file": "330ce62b3e04.mp3",
  "tts": "ちかい。"
 },
 {
  "file": "3338dd560e44.mp3",
  "tts": "しよう。"
 },
 {
  "file": "3357df4bdf9a.mp3",
  "tts": "あなたをたべるためですよ！"
 },
 {
  "file": "3389ecbeabeb.mp3",
  "tts": "おおきに。"
 },
 {
  "file": "33f8e3b9d490.mp3",
  "tts": "しずかじゃなかったです。"
 },
 {
  "file": "343a05238b20.mp3",
  "tts": "くつをはきます。"
 },
 {
  "file": "344775780e56.mp3",
  "tts": "まほうつかい。"
 },
 {
  "file": "34540f8581c9.mp3",
  "tts": "うしろにいるのわだれですか？"
 },
 {
  "file": "347ef66ccd42.mp3",
  "tts": "なんでそないにおそいんですか？"
 },
 {
  "file": "34b7608ac012.mp3",
  "tts": "ねこ。"
 },
 {
  "file": "3550135b4e2b.mp3",
  "tts": "すみません、これください、おみずもください、ごちそうさま！"
 },
 {
  "file": "3594fe3f2316.mp3",
  "tts": "やせガエル、まけたらあかんで！いっさがここにおるで！"
 },
 {
  "file": "35b70e55005c.mp3",
  "tts": "セミわなつにミーンミーンとなきます。"
 },
 {
  "file": "35eacf70151c.mp3",
  "tts": "きた。"
 },
 {
  "file": "3619c1902000.mp3",
  "tts": "ちょっけいよんセンチくらいにまるめてね。てをぬらすとくっつかないよ。"
 },
 {
  "file": "36ce94d0a8d3.mp3",
  "tts": "たれをまわしいれていっぷんくらいいためたら、ごはんにのせてね。"
 },
 {
  "file": "36f58285697c.mp3",
  "tts": "かきをたべていたら、ほうりゅうじのかねがなりました。"
 },
 {
  "file": "374f3bf8542e.mp3",
  "tts": "そのてをうえに。"
 },
 {
  "file": "3769445017c9.mp3",
  "tts": "うえわきる、したわはく、ぼうしわかぶる、おぼえたね！"
 },
 {
  "file": "378d1ee8c181.mp3",
